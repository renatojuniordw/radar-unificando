generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                  @id @default(uuid()) @db.Uuid
  email                 String                  @unique @db.VarChar(255)
  passwordHash          String                  @map("password_hash") @db.VarChar(255)
  name                  String?                 @db.VarChar(255)
  createdAt             DateTime                @default(now()) @map("created_at")
  sessions              Session[]
  profiles              Profile[]
  jobs                  Job[]
  applications          Application[]
  newCompanies          NewCompany[]
  pipelineRuns          PipelineRun[]
  companyPresence       CompanyPresence[]
  generatedContentCache GeneratedContentCache[]
  chats                 Chat[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Profile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  skills          Json     @default("[]")
  experienceYears Int?     @map("experience_years")
  seniority       String?  @db.VarChar(50)
  currentRole     String?  @map("current_role") @db.VarChar(255)
  area            String?  @db.VarChar(100)
  education       Json?    @default("[]")
  resumeText      String?  @map("resume_text") @db.Text
  resumeMarkdown  String?  @map("resume_markdown") @db.Text
  parsedData      Json?    @map("parsed_data")
  profileSource   String?  @default("manual") @map("profile_source") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Job {
  id                    String                  @id @default(uuid()) @db.Uuid
  userId                String                  @map("user_id") @db.Uuid
  source                String                  @default("gupy_api") @db.VarChar(20)
  company               String                  @db.VarChar
  platform              String                  @db.VarChar
  onList                String?                 @default("Não") @map("on_list") @db.VarChar(3)
  roleCategory          String?                 @map("role_category") @db.VarChar
  title                 String?                 @db.VarChar
  type                  String?                 @db.VarChar
  location              String?                 @db.VarChar
  link                  String                  @db.VarChar
  companyNameOnPlatform String?                 @map("company_name_on_platform") @db.VarChar
  postedAt              String?                 @map("posted_at") @db.VarChar
  description           String?                 @db.Text
  skillsRequired        Json?                   @map("skills_required")
  score                 Float?                  @db.Real
  alert                 String?                 @default("") @db.VarChar
  detectedAt            String?                 @map("detected_at") @db.VarChar
  status                String                  @default("active") @db.VarChar(20)
  lastCheckedAt         DateTime?               @map("last_checked_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications          Application[]
  generatedContentCache GeneratedContentCache[]

  @@unique([userId, link])
  @@index([status, lastCheckedAt])
  @@map("jobs")
}

model Chat {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  externalId String        @map("external_id") @db.VarChar(100)
  title      String?       @db.VarChar(255)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]

  @@unique([userId, externalId])
  @@index([userId, updatedAt])
  @@map("chats")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @map("chat_id") @db.Uuid
  position  Int
  role      String   @db.VarChar(20)
  content   Json
  createdAt DateTime @default(now()) @map("created_at")
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, position])
  @@map("chat_messages")
}

model GeneratedContentCache {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  jobId     String?  @map("job_id") @db.Uuid
  kind      String   @db.VarChar(30)
  cacheKey  String   @map("cache_key") @db.VarChar(64)
  content   Json
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, cacheKey])
  @@index([expiresAt])
  @@map("generated_content_cache")
}

model Application {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  jobId     String           @map("job_id") @db.Uuid
  stage     String           @default("discovered") @db.VarChar
  score     Float?           @db.Real
  breakdown Json?
  notes     String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  logs      ApplicationLog[]

  @@map("applications")
}

model ApplicationLog {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  fromStage     String?     @map("from_stage") @db.VarChar
  toStage       String      @map("to_stage") @db.VarChar
  createdAt     DateTime    @default(now()) @map("created_at")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_logs")
}

model NewCompany {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  name       String   @db.VarChar
  totalJobs  Int?     @default(0) @map("total_jobs")
  careersUrl String?  @map("careers_url") @db.VarChar
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("new_companies")
}

model PipelineRun {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  status            String    @default("pending") @db.VarChar(20)
  totalJobs         Int?      @default(0) @map("total_jobs")
  gupyJobs          Int?      @default(0) @map("gupy_jobs")
  inhireJobs        Int?      @default(0) @map("inhire_jobs")
  newCompaniesFound Int?      @default(0) @map("new_companies_found")
  discoveryEnabled  Boolean?  @default(true) @map("discovery_enabled")
  startedAt         DateTime? @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pipeline_runs")
}

model CompanyPresence {
  id              String  @id @default(uuid()) @db.Uuid
  userId          String  @map("user_id") @db.Uuid
  company         String  @db.VarChar
  hasGupy         String? @default("") @map("has_gupy") @db.VarChar(3)
  gupyPage        String? @map("gupy_page") @db.VarChar
  hasInhire       String? @default("") @map("has_inhire") @db.VarChar(3)
  inhirePage      String? @map("inhire_page") @db.VarChar
  totalInhireJobs Int?    @default(0) @map("total_inhire_jobs")
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_presence")
}
