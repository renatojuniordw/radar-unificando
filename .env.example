DB_USER=radar
DB_PASSWORD= # openssl rand -base64 32
DB_NAME=radar_unificando
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:11011/${DB_NAME}
AUTH_SECRET= # openssl rand -base64 64
AUTH_URL=http://localhost:11010

# LLM Provider (Verboo, OpenAI ou compatível)
# Verboo:  https://code.verboo.ai/router/v1
# OpenAI:  https://api.openai.com/v1
AI_BASE_URL=https://code.verboo.ai/router/v1
AI_API_KEY= # sua chave
AI_MODEL=gpt-4o-mini
# Preço por 1M tokens (usado no orçamento diário global) — defaults: input 0.15, output 0.6
AI_INPUT_PRICE_PER_1M=0.15
AI_OUTPUT_PRICE_PER_1M=0.6
# Máx. tokens de saída por resposta do chat (default: 2000)
CHAT_MAX_OUTPUT_TOKENS=2000

# Redis Rate Limit
REDIS_HOST=localhost
REDIS_PORT=11012
REDIS_PASSWORD=radar_redis_secret_password_change_in_prod

# Resend (recuperação de senha)
# Deixe RESEND_API_KEY vazio no dev para logar o link de recuperação no console do servidor.
# Crie a chave em https://resend.com/api-keys e verifique o domínio do MAIL_FROM.
RESEND_API_KEY= # sua chave da Resend
MAIL_FROM=Radar Unificando <no-reply@radarunificando.com.br>

# Orçamento diário global (soma o custo de IA de todos os usuários; protege contra pico de custo agregado)
GLOBAL_DAILY_BUDGET_USD=0.95 # ~R$5/dia (ajuste pela cotação atual)

# Tetos de tokens de IA por usuário (defaults abaixo; renovam à meia-noite e no dia 1º)
DAILY_TOKEN_LIMIT=100000
MONTHLY_TOKEN_LIMIT=2000000
IP_DAILY_TOKEN_LIMIT=300000

# URL base do app (usada no middleware para a allowlist de CORS)
NEXTAUTH_URL=http://localhost:11010

# Origem da extensão Chrome — OBRIGATÓRIO preencher com o ID completo após carregar a extensão em
# chrome://extensions. Ex.: EXTENSION_ORIGIN=chrome-extension://abcdefghijklmnop
# (o valor "chrome-extension://" sozinho NÃO funciona — o middleware usa correspondência exata)
EXTENSION_ORIGIN=

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-CPZPJGTL92

# ID de afiliado Udemy (público — vai no ?ref= dos links). Quando preenchido,
# é adicionado automaticamente aos deep links de cursos da Udemy no catálogo.
# Obtenha após aprovação na rede de afiliados (Rakuten/Impact).
NEXT_PUBLIC_UDEMY_AFFILIATE_REF=

# Impact Radius API (Udemy Affiliate Integration)
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
# Id do catálogo da Udemy na Impact (opcional — auto-descoberto por GET /Catalogs).
IMPACT_UDEMY_CATALOG_ID=

# Retenção de dados (LGPD) — rotina de limpeza automática
# Segredo que autentica a chamada externa a GET /api/cron/cleanup (header x-cron-secret).
# Gere com: openssl rand -base64 32
CRON_SECRET=
# Inatividade de chats para exclusão automática (meses; default: 12)
RETENTION_INACTIVE_CHAT_MONTHS=12


