DB_USER=radar
DB_PASSWORD= # openssl rand -base64 32
DB_NAME=radar_unificando
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:11011/${DB_NAME}
AUTH_SECRET= # openssl rand -base64 64
AUTH_URL=http://localhost:11010

# LLM Provider (Verboo, OpenAI ou compatível)
# Verboo:  https://code.verboo.ai/router/v1
# OpenAI:  https://api.openai.com/v1
AI_BASE_URL=https://code.verboo.ai/router/v1
AI_API_KEY= # sua chave
AI_MODEL=gpt-4o-mini

# Redis Rate Limit
REDIS_HOST=localhost
REDIS_PORT=11012
REDIS_PASSWORD=radar_redis_secret_password_change_in_prod

# Orçamento diário global (soma o custo de IA de todos os usuários; protege contra pico de custo agregado)
GLOBAL_DAILY_BUDGET_USD=0.95 # ~R$5/dia (ajuste pela cotação atual)

# Origem da extensão Chrome — OBRIGATÓRIO preencher com o ID completo após carregar a extensão em
# chrome://extensions. Ex.: EXTENSION_ORIGIN=chrome-extension://abcdefghijklmnop
# (o valor "chrome-extension://" sozinho NÃO funciona — o middleware usa correspondência exata)
EXTENSION_ORIGIN=

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-CPZPJGTL92

# ID de afiliado Udemy (público — vai no ?ref= dos links). Quando preenchido,
# é adicionado automaticamente aos deep links de cursos da Udemy no catálogo.
# Obtenha após aprovação na rede de afiliados (Rakuten/Impact).
NEXT_PUBLIC_UDEMY_AFFILIATE_REF=

