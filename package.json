  "description": "Radar Unificando — plataforma de busca inteligente de vagas remotas",
  "private": true,
  "scripts": {
    "dev": "next dev -p 11010",
    "build": "next build",
    "start": "next start -p 11010",
    "lint": "eslint src",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
