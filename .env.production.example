# -----------------------------------------------------------------------------
# PRODUCTION ENVIRONMENT VARIABLE TEMPLATE
# Save a copy as .env on your VPS
# -----------------------------------------------------------------------------

# PostgreSQL Credentials
DB_USER=radar
DB_PASSWORD= # Generate with: openssl rand -base64 32
DB_NAME=radar_unificando
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

# NextAuth / Auth Secret
AUTH_SECRET= # Generate with: openssl rand -base64 64
AUTH_URL=http://localhost:11010 # Or https://seudominio.com.br when using Nginx

# LLM Provider (Verboo / OpenAI / OpenRouter)
AI_BASE_URL=https://code.verboo.ai/router/v1
AI_API_KEY=your_verboo_or_openai_api_key
AI_MODEL=gpt-4o-mini
# Price per 1M tokens (used in the global daily budget) — defaults: input 0.15, output 0.6
AI_INPUT_PRICE_PER_1M=0.15
AI_OUTPUT_PRICE_PER_1M=0.6
# Max output tokens per chat response (default: 2000)
CHAT_MAX_OUTPUT_TOKENS=2000

# Redis Credentials & Connection
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD= # Generate with: openssl rand -base64 32

# Global Daily Budget (sums the AI cost of ALL users; protects against aggregate cost spikes)
GLOBAL_DAILY_BUDGET_USD=0.95 # ~R$5/day (adjust for current exchange rate)

# Per-user AI token caps (defaults below; reset at midnight and on the 1st of each month)
DAILY_TOKEN_LIMIT=100000
MONTHLY_TOKEN_LIMIT=2000000
IP_DAILY_TOKEN_LIMIT=300000

# Google Analytics 4 (public)
NEXT_PUBLIC_GA_ID=G-CPZPJGTL92

# App base URL (used by the middleware CORS allowlist)
NEXTAUTH_URL=https://radar.unificando.com.br

# Chrome extension origin — MUST be the full origin including the extension ID, e.g.
# EXTENSION_ORIGIN=chrome-extension://<id> (copy the ID after loading the extension).
# The bare "chrome-extension://" prefix alone does NOT work (middleware uses exact match).
EXTENSION_ORIGIN=

# Udemy affiliate ID (public — goes in the ?ref= of links). When set, it is
# appended automatically to Udemy course deep links in the curated catalog.
# Obtain it after affiliate network approval (Rakuten/Impact).
NEXT_PUBLIC_UDEMY_AFFILIATE_REF=

# Impact Radius API (Udemy Affiliate) — server-side only
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
# Id do catálogo da Udemy na Impact (opcional — auto-descoberto por GET /Catalogs).
IMPACT_UDEMY_CATALOG_ID=
